{
  "name": "sp-worktrack",
  "version": "1.0.0",
  "description": "Production Entry Application",
  "main": "main.js",
  "author": "SP WorkTrack",
  "license": "ISC",


  "scripts": {
  "start": "electron .",
  "server": "node server/app.js",
  "db:setup": "node server/db/setupPocketBaseSchema.js",
  "db:seed": "node server/db/seedFromAdminOverrides.js",
  "dist": "electron-builder"
},
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jspdf": "^4.1.0",
    "nodemailer": "^7.0.11",
    "puppeteer": "^23.11.1"
  },
  "build": {
    "appId": "com.sopan.spworktrack",
    "productName": "SP WorkTrack",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
