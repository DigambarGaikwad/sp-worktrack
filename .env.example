# SP WorkTrack DB Edition - Environment Example

# API server
SPWT_API_PORT=3030
SPWT_STORAGE_MODE=pocketbase

# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

# Email / PIN recovery / report sender
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SP WorkTrack <your-email@example.com>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# Google Sheets sync / backup
# Keep disabled until Apps Script Web App URL and secret are ready.
GOOGLE_SHEET_BACKUP_ENABLED=false
GOOGLE_SHEET_WEBAPP_URL=
GOOGLE_SHEET_BACKUP_SECRET=
GOOGLE_SHEET_BACKUP_TIMEOUT_MS=15000
GOOGLE_SHEET_BACKUP_SCHEDULER_INTERVAL_MS=60000
